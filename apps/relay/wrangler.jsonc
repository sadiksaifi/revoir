{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revoir-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "revoir-review-jobs",
      },
    ],
  },
  "keep_vars": true,
}
