{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "keywords": [],
  "author": "",
  "bin": {
    "revoir": "dist/main.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @revoir/contracts run build",
    "build": "tsc",
    "predev": "pnpm --filter @revoir/contracts run build",
    "dev": "tsx src/main.ts",
    "format": "pnpm --workspace-root run format apps/cli",
    "format:check": "pnpm --workspace-root run format:check apps/cli",
    "lint": "pnpm --workspace-root run lint apps/cli",
    "lint:fix": "pnpm --workspace-root run lint:fix apps/cli",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @revoir/contracts run build",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "pretypecheck": "pnpm --filter @revoir/contracts run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@revoir/contracts": "workspace:*",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
