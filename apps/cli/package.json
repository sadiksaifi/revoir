{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "keywords": [],
  "author": "",
  "bin": {
    "revoir": "dist/main.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "format": "pnpm --workspace-root run format apps/cli",
    "format:check": "pnpm --workspace-root run format:check apps/cli",
    "lint": "pnpm --workspace-root run lint apps/cli",
    "lint:fix": "pnpm --workspace-root run lint:fix apps/cli",
    "start": "node dist/main.js",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
