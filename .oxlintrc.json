{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "apps/cli/src/generated/relay-artifact.ts",
    "apps/relay/worker-configuration.d.ts"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["apps/cli/**/*.{js,mjs,cjs,ts,mts,cts}"],
      "env": {
        "node": true
      }
    }
  ]
}
