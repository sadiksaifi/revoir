{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/coverage/**", "**/dist/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["apps/cli/**/*.{js,mjs,cjs,ts,mts,cts}"],
      "env": {
        "node": true
      }
    }
  ]
}
